FROM node:20-bookworm-slim AS build

WORKDIR /app
ENV CYPRESS_INSTALL_BINARY=0

ARG REACT_APP_FRONTEND_BASE_URL=http://localhost:3000
ARG REACT_APP_API_BASE_URL=http://localhost:5001
ARG REACT_APP_WS_SIGNALING_URL=ws://localhost:8080
ARG REACT_APP_WS_RESULT_URL=ws://localhost:8081
ARG REACT_APP_AI_SERVER_URL=http://localhost:5020
ARG REACT_APP_RTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
ARG REACT_APP_RTC_TURN_URLS=
ARG REACT_APP_RTC_TURN_USERNAME=
ARG REACT_APP_RTC_TURN_CREDENTIAL=

ENV REACT_APP_FRONTEND_BASE_URL=${REACT_APP_FRONTEND_BASE_URL}
ENV REACT_APP_API_BASE_URL=${REACT_APP_API_BASE_URL}
ENV REACT_APP_WS_SIGNALING_URL=${REACT_APP_WS_SIGNALING_URL}
ENV REACT_APP_WS_RESULT_URL=${REACT_APP_WS_RESULT_URL}
ENV REACT_APP_AI_SERVER_URL=${REACT_APP_AI_SERVER_URL}
ENV REACT_APP_RTC_STUN_URLS=${REACT_APP_RTC_STUN_URLS}
ENV REACT_APP_RTC_TURN_URLS=${REACT_APP_RTC_TURN_URLS}
ENV REACT_APP_RTC_TURN_USERNAME=${REACT_APP_RTC_TURN_USERNAME}
ENV REACT_APP_RTC_TURN_CREDENTIAL=${REACT_APP_RTC_TURN_CREDENTIAL}

COPY package*.json ./
COPY patches ./patches
RUN npm ci --no-audit --no-fund

COPY . .
RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
